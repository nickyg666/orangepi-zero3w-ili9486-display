/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&spi3>;
		__overlay__ {
			status = "okay";

			spidev@0 {
				status = "disabled";
			};

			spidev@1 {
				status = "disabled";
			};

			ili9486@0 {
				compatible = "iltek,ili9486";
				reg = <0>;
				spi-max-frequency = <32000000>;
				dc-gpios = <&r_pio 0 3 0>;
				reset-gpios = <&pio 3 0 0>;
				width = <320>;
				height = <480>;
				scale = <1>;
			};

			ads7846@1 {
				compatible = "ti,tsc2046";
				reg = <1>;
				spi-max-frequency = <2000000>;
				interrupt-parent = <&pio>;
				interrupts = <1 0 8>;			/* PB0 (GPIO 32), IRQ_TYPE_LEVEL_LOW */
				pendown-gpios = <&pio 1 0 1>;		/* PB0 (GPIO 32), GPIO_ACTIVE_LOW */
				ti,pressure-max = <4095>;		/* 12-bit full-scale; <255> caused Rt>pressure_max drops */
			};
		};
	};
};
