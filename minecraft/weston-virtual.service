[Unit]
Description=Wayland compositor (Weston) on virtual display :1
After=xvfb-virtual-display.service
Wants=xvfb-virtual-display.service

[Service]
Type=simple
User=orangepi
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/weston --backend=x11-backend.so --width=1920 --height=1080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
