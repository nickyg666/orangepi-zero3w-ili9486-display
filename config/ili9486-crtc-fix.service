[Unit]
Description=Ensure ILI9486 LCD CRTC is committed at boot
After=multi-user.target
Wants=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "sleep 10; if grep -q \"enable=0\" /sys/kernel/debug/dri/1/state 2>/dev/null; then systemctl restart gdm3; sleep 10; fi; chvt 1"

[Install]
WantedBy=multi-user.target
